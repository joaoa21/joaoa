# Cabeçalhos HTTP do Netlify (https://docs.netlify.com/routing/headers/)

# Segurança, em todas as páginas
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Cache longo: fontes e imagens não mudam de conteúdo sem mudar de nome.
# HTML, CSS e JS ficam com o padrão do Netlify (revalidação por ETag), para
# uma mudança de estilo aparecer na hora.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=2592000
/assets/projetos/*
  Cache-Control: public, max-age=2592000
/projetos/:projeto/assets/*
  Cache-Control: public, max-age=2592000
/projetos/sites/:projeto/assets/*
  Cache-Control: public, max-age=2592000
/projetos/igaming/pop-up-animado/assets/*
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
